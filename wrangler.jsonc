{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "search-engine-switcher-gobing",
  "main": "index.js",
  "compatibility_date": "2024-12-18",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html", "**/*.xml"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

